<?xml version="1.0"?>
<!-- 实车模型(纯运动学,无仿真标签):四麦轮 + YbImu + PAVO2 雷达。
     轮位仅用于可视化;运动学以 wheel_kinematics 参数为准
     (wheel_radius=0.0763, lx+ly=0.20, gear=19.2)。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myrobot_real">

  <xacro:arg name="laser_xyz" default="0 0 0.12"/>
  <xacro:arg name="imu_xyz" default="0 0 0.06"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.4 0.1"/></geometry>
      <origin xyz="0 0 0.05"/>
      <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.4 0.1"/></geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name xyz">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="0.0763" length="0.04"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <wheel name="left_front_wheel"  xyz=" 0.1  0.22 0"/>
  <wheel name="right_front_wheel" xyz=" 0.1 -0.22 0"/>
  <wheel name="left_back_wheel"   xyz="-0.1  0.22 0"/>
  <wheel name="right_back_wheel"  xyz="-0.1 -0.22 0"/>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="$(arg imu_xyz)" rpy="0 0 0"/>
  </joint>

  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="$(arg laser_xyz)" rpy="0 0 0"/>
  </joint>

</robot>
